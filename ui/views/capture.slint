import { ScrollView } from "std-widgets.slint";
import { Icons, Theme } from "../theme.slint";
import { Badge, FlatButton, IconBox, InlineNotice, PageHeading, PageSubtitle, SectionCard, SectionHeading } from "../components.slint";

component QuickAction inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <image> icon-source;
    in property <bool> enabled: true;
    in property <bool> destructive: false;
    in property <bool> active: false;
    callback clicked;
    property <bool> hovered: action-touch.has-hover;

    height: 82px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: 9px;
    border-width: 1px;
    border-color: root.active || (root.hovered && root.enabled) ? (root.destructive ? Theme.accent : Theme.primary) : Theme.border;
    background: root.hovered && root.enabled ? Theme.surface-hover : Theme.surface;
    forward-focus: action-focus;
    accessible-role: button;
    accessible-label: root.title + (root.subtitle != "" ? ", " + root.subtitle : "");
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    VerticalLayout {
        padding-left: 13px;
        padding-right: 10px;
        padding-top: 11px;
        padding-bottom: 10px;
        spacing: 7px;

        HorizontalLayout {
            spacing: 9px;

            IconBox {
                icon-source: root.icon-source;
                tint: !root.enabled ? Theme.text-muted : (root.destructive ? Theme.accent : Theme.primary-bright);
                icon-size: 20px;
                box-width: 21px;
            }
            Text {
                horizontal-stretch: 1;
                text: root.title;
                color: root.enabled ? Theme.text : Theme.text-muted;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        Text {
            text: root.subtitle;
            color: root.enabled ? Theme.text-muted : Theme.text-muted;
            font-size: 11.5px;
            overflow: elide;
        }
    }

    action-focus := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.enabled;

        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    action-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            action-focus.focus();
            root.clicked();
        }
    }
}

component ResultRow inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> link: false;
    in property <bool> wrap-value: false;

    vertical-stretch: 0;
    spacing: 6px;

    HorizontalLayout {
        spacing: 10px;

        Text {
            width: 106px;
            text: root.label;
            color: Theme.text-muted;
            font-size: 12.5px;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.value;
            color: root.link ? Theme.primary-bright : Theme.text-soft;
            font-size: 12.5px;
            vertical-alignment: center;
            height: self.preferred-height;
            wrap: root.wrap-value ? word-wrap : no-wrap;
            overflow: root.wrap-value ? clip : elide;

            Tooltip { text: @markdown("\{root.value}"); }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        @children
    }
}

export component CaptureView inherits Rectangle {
    background: transparent;

    in property <bool> busy;
    in property <bool> uploading;
    in property <float> upload-progress;
    in property <bool> recording;
    in property <bool> configured;
    in property <bool> auto-upload;
    in property <string> uploader-name;
    in property <bool> capture-enabled;
    in property <string> region-hotkey;
    in property <string> recording-hotkey;
    in property <string> screen-hotkey;
    in property <string> clipboard-hotkey;
    in property <string> status-text;
    in property <string> status-detail;
    in property <string> last-link;
    in property <string> last-local-path;
    in property <string> last-delete-url;
    in property <bool> last-delete-saved;
    in property <bool> update-available;
    in property <string> update-version;

    pure callback shortcut-text(string) -> string;
    callback capture-region();
    callback record-region();
    callback capture-screen();
    callback upload-clipboard();
    callback choose-file();
    callback cancel-upload();
    callback open-link();
    callback copy-link();
    callback open-local();
    callback reveal-local();
    callback copy-file();
    callback copy-delete();
    callback open-delete();
    callback open-update();
    callback show-settings();
    callback show-capture-settings();
    callback show-general-settings();

    property <bool> show-activity: root.busy || root.uploading || root.recording || root.last-link != ""
            || root.last-local-path != "" || root.last-delete-url != "" || root.status-text != "Ready";
    property <bool> status-is-error: root.status-text == "Upload failed"
            || root.status-text == "Upload cancelled"
            || root.status-text == "Upload timed out"
            || root.status-text == "Saved locally, upload failed"
            || root.status-text == "Saved locally, upload cancelled"
            || root.status-text == "Saved locally, upload timed out"
            || root.status-text == "Capture failed"
            || root.status-text == "Save failed"
            || root.status-text == "Settings invalid"
            || root.status-text == "Setup required"
            || root.status-text == "Settings not saved";
    property <bool> narrow: root.width < 680px;

    ScrollView {
        VerticalLayout {
            padding-right: 6px;
            spacing: 14px;

        HorizontalLayout {
            spacing: 12px;
            cross-axis-alignment: center;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;

                PageHeading { text: "Capture & upload"; }
                if !root.narrow: PageSubtitle { text: "Capture a region, record your screen, or upload a file."; }
            }
            Rectangle { vertical-stretch: 1; background: transparent; }
            if root.auto-upload && root.configured: Badge {
                text: "Auto-upload → " + root.uploader-name;
                tone: 1;
                clicked => { root.show-settings(); }
            }
            if !root.auto-upload || !root.configured: Badge {
                text: root.auto-upload ? "Uploader not ready" : "Auto-upload off";
                tone: 0;
                clicked => {
                    if root.auto-upload { root.show-settings(); }
                    else { root.show-general-settings(); }
                }
            }
        }

        if !root.configured: InlineNotice {
            text: "No upload destination yet";
            detail: "Captures are saved on this PC. Choose a provider to upload and get a public link.";
            action-text: "Choose provider";
            action => { root.show-settings(); }
        }

        if root.update-available: InlineNotice {
            text: "ShareR " + root.update-version + " is available";
            detail: "A newer release can be installed from the project page.";
            action-text: "View release";
            kind: 1;
            action => { root.open-update(); }
        }

        SectionHeading { text: "Quick actions"; }

        if !root.narrow: HorizontalLayout {
            spacing: 8px;

            QuickAction {
                title: "Region";
                subtitle: root.region-hotkey;
                icon-source: Icons.crop;
                enabled: !root.busy && root.capture-enabled;
                clicked => { root.capture-region(); }
            }
            QuickAction {
                title: root.recording ? "Stop" : "Record";
                subtitle: root.recording ? (root.auto-upload && root.configured ? "Finish and upload" : "Finish and save") : root.recording-hotkey;
                icon-source: Icons.recording;
                destructive: root.recording;
                enabled: (!root.busy || root.recording) && root.capture-enabled;
                clicked => { root.record-region(); }
            }
            QuickAction {
                title: "Screen";
                subtitle: root.screen-hotkey;
                icon-source: Icons.screen;
                enabled: !root.busy && root.capture-enabled;
                clicked => { root.capture-screen(); }
            }
            QuickAction {
                title: "Clipboard";
                subtitle: root.clipboard-hotkey;
                icon-source: Icons.clipboard;
                enabled: !root.busy && root.configured;
                clicked => { root.upload-clipboard(); }
            }
            QuickAction {
                title: "File";
                subtitle: "Choose and upload";
                icon-source: Icons.file;
                enabled: !root.busy && root.configured;
                clicked => { root.choose-file(); }
            }
        }

        if root.narrow: VerticalLayout {
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;

                QuickAction {
                    title: "Region";
                    subtitle: root.region-hotkey;
                    icon-source: Icons.crop;
                    enabled: !root.busy && root.capture-enabled;
                    clicked => { root.capture-region(); }
                }
                QuickAction {
                    title: root.recording ? "Stop" : "Record";
                    subtitle: root.recording ? (root.auto-upload && root.configured ? "Finish and upload" : "Finish and save") : root.recording-hotkey;
                    icon-source: Icons.recording;
                    destructive: root.recording;
                    enabled: (!root.busy || root.recording) && root.capture-enabled;
                    clicked => { root.record-region(); }
                }
                QuickAction {
                    title: "Screen";
                    subtitle: root.screen-hotkey;
                    icon-source: Icons.screen;
                    enabled: !root.busy && root.capture-enabled;
                    clicked => { root.capture-screen(); }
                }
            }
            HorizontalLayout {
                spacing: 8px;

                QuickAction {
                    title: "Clipboard";
                    subtitle: root.clipboard-hotkey;
                    icon-source: Icons.clipboard;
                    enabled: !root.busy && root.configured;
                    clicked => { root.upload-clipboard(); }
                }
                QuickAction {
                    title: "File";
                    subtitle: "Choose and upload";
                    icon-source: Icons.file;
                    enabled: !root.busy && root.configured;
                    clicked => { root.choose-file(); }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
            }
        }

        if root.show-activity: SectionHeading { text: root.busy || root.recording ? "Activity" : "Last result"; }

        if root.show-activity: SectionCard {
            border-color: root.status-is-error ? Theme.danger : Theme.border;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 10px;

                    Rectangle {
                        width: 3px;
                        border-radius: 2px;
                        background: root.status-is-error ? Theme.danger : (root.busy || root.uploading ? Theme.accent : Theme.success);
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;

                        Text {
                            text: root.status-text;
                            color: Theme.text;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        Text {
                            text: root.status-detail;
                            color: Theme.text-soft;
                            font-size: 12.5px;
                            height: self.preferred-height;
                            wrap: word-wrap;
                        }
                    }
                }

                if root.uploading: HorizontalLayout {
                    spacing: 10px;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 5px;
                        border-radius: 3px;
                        background: Theme.surface-raised;

                        Rectangle {
                            width: parent.width * root.upload-progress;
                            height: parent.height;
                            border-radius: 3px;
                            background: Theme.primary;
                            animate width { duration: 90ms; }
                        }
                    }
                    Text {
                        width: 38px;
                        text: round(root.upload-progress * 100) + "%";
                        color: Theme.text-soft;
                        font-size: 11.5px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    FlatButton {
                        text: "Cancel";
                        min-width: 76px;
                        clicked => { root.cancel-upload(); }
                    }
                }

                if (root.busy || root.uploading || root.recording) && (root.last-link != "" || root.last-local-path != "" || root.last-delete-url != ""): Text {
                    text: "Previous result";
                    color: Theme.text-muted;
                    font-size: 12.5px;
                    font-weight: 600;
                }

                if root.last-link != "": ResultRow {
                    label: "Public link";
                    value: root.last-link;
                    link: true;

                    FlatButton {
                        text: "Copy link";
                        description: "Copy the public link to the uploaded file.";
                        icon-source: Icons.copy;
                        has-icon: true;
                        min-width: 110px;
                        clicked => { root.copy-link(); }
                    }
                    FlatButton {
                        text: "Open link";
                        description: "Open the uploaded file's public link in your browser.";
                        icon-source: Icons.open;
                        has-icon: true;
                        min-width: 110px;
                        clicked => { root.open-link(); }
                    }
                }

                if root.last-local-path != "": ResultRow {
                    label: "Local file";
                    value: root.last-local-path;

                    FlatButton {
                        text: "Open file";
                        description: "Open the saved file on this computer.";
                        min-width: 94px;
                        clicked => { root.open-local(); }
                    }
                    FlatButton {
                        text: "Show in folder";
                        description: "Locate the saved file in your file manager.";
                        min-width: 126px;
                        clicked => { root.reveal-local(); }
                    }
                    FlatButton {
                        text: "Copy file";
                        description: "Copy the local file, not its public link, to the clipboard.";
                        min-width: 92px;
                        clicked => { root.copy-file(); }
                    }
                }

                if root.last-delete-url != "": ResultRow {
                    label: "Remote deletion";
                    value: root.last-delete-saved ? "Deletion link saved in History" : "Deletion link is not in History; copy it now";
                    wrap-value: true;

                    FlatButton {
                        text: "Copy deletion link";
                        description: "Copy the private deletion link. Anyone with this link may delete the uploaded copy.";
                        min-width: 150px;
                        clicked => { root.copy-delete(); }
                    }
                    FlatButton {
                        text: "Open deletion page…";
                        description: "Open the host's deletion page. This may delete the uploaded copy immediately; the local file and history entry stay.";
                        min-width: 176px;
                        danger: true;
                        clicked => { root.open-delete(); }
                    }
                }
            }
        }

        if !root.show-activity: SectionCard {
            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: "Nothing captured yet";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 600;
                }
                Text {
                    text: "Use a shortcut or the actions above to capture. Find saved files and uploaded links in History.";
                    color: Theme.text-muted;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 18px;

                    Text { text: root.region-hotkey; color: Theme.primary-bright; font-size: 12.5px; font-weight: 600; }
                    Text { text: "Region"; color: Theme.text-muted; font-size: 12.5px; }
                    Rectangle { width: 1px; height: 14px; background: Theme.border; y: (parent.height - self.height) / 2; }
                    Text { text: root.screen-hotkey; color: Theme.primary-bright; font-size: 12.5px; font-weight: 600; }
                    Text { text: "Full screen"; color: Theme.text-muted; font-size: 12.5px; }
                }
            }
        }

        Rectangle { vertical-stretch: 1; background: transparent; }
        }
    }
}
