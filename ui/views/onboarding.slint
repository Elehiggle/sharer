import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ChoiceCard, CompactField, FlatButton, IconBox, SelectableButton, ToggleRow } from "../components.slint";

export component OnboardingView inherits Rectangle {
    in-out property <int> step: 0;
    in-out property <int> wizard-provider: 3;
    in-out property <bool> wizard-auto-upload: true;
    in-out property <bool> wizard-sound: true;
    in-out property <bool> wizard-start-at-login: false;
    in-out property <string> wizard-imgur-credential;
    in-out property <string> wizard-vgy-credential;
    in-out property <string> wizard-sul-credential;
    in-out property <string> wizard-uploader-url;
    in-out property <string> wizard-header-name;
    in-out property <string> wizard-header-value;
    in-out property <int> wizard-lifetime-seconds: 86400;
    in-out property <string> error;
    in property <bool> replay: false;
    in property <bool> resetting: false;
    in property <bool> save-captures: true;
    in property <string> capture-directory;

    callback finish();
    callback skip();
    callback continue-setup();
    callback endpoint-edited();
    callback header-edited();

    property <bool> compact: root.height < 560px;
    property <bool> local-only: root.wizard-provider == -1;
    property <string> destination-name: root.wizard-provider == 3 ? "Uguu" : root.wizard-provider == 1 ? "Imgur" : root.wizard-provider == 2 ? "vgy.me" : root.wizard-provider == 4 ? "transfer.sh" : root.wizard-provider == 5 ? "s-ul" : root.wizard-provider == 0 ? "Custom endpoint" : "This PC";
    property <string> local-copies: (root.save-captures || root.local-only || !root.wizard-auto-upload) ? "On — " + (root.capture-directory == "" ? "Pictures/ShareR" : root.capture-directory) : "Off";

    background: #06090bf2;

    TouchArea { clicked => { } }

    Rectangle {
        width: min(parent.width - 48px, 680px);
        height: min(parent.height - 40px, 570px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.border-bright;
        background: Theme.surface;

        VerticalLayout {
            padding: root.compact ? 16px : 24px;
            spacing: root.compact ? 8px : 16px;

            HorizontalLayout {
                spacing: 12px;

                IconBox {
                    icon-source: @image-url("../../assets/sharer.png");
                    tint: transparent;
                    icon-size: 34px;
                    box-width: 36px;
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 1px;

                    Text { text: "ShareR"; color: Theme.text; font-size: 18px; font-weight: 600; }
                    Text { text: "Capture, share, keep a history"; color: Theme.text-muted; font-size: 12.5px; }
                }
                Text { text: "Step " + (root.step + 1) + " of 2"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
            }

            Rectangle { height: 1px; background: Theme.border; }

            if root.step == 0: ScrollView {
                vertical-stretch: 1;
                min-height: 0px;

                VerticalLayout {
                    padding-right: 6px;
                    spacing: 14px;

                    Text { text: "Where should uploads go?"; color: Theme.text; font-size: root.compact ? 18px : 21px; font-weight: 600; }
                    Text { text: root.resetting ? "Review reset defaults. Credentials, capture folder, history and files are kept. Nothing changes until you finish." : "Pick a destination. Nothing changes until you finish."; color: Theme.text-soft; font-size: 13px; wrap: word-wrap; }

                    Rectangle {
                        height: root.compact ? 292px : 328px;

                        ChoiceCard {
                            x: 0px;
                            y: 0px;
                            width: (parent.width - 8px) / 2;
                            height: root.compact ? 66px : 76px;
                            title: "Uguu";
                            subtitle: "No account. Public, temporary links.";
                            selected: root.wizard-provider == 3;
                            clicked => { root.wizard-provider = 3; root.wizard-auto-upload = true; root.error = ""; }
                        }
                        ChoiceCard {
                            x: (parent.width + 8px) / 2;
                            y: 0px;
                            width: (parent.width - 8px) / 2;
                            height: root.compact ? 66px : 76px;
                            title: "Imgur";
                            subtitle: "Needs a free Imgur client ID.";
                            selected: root.wizard-provider == 1;
                            clicked => { root.wizard-provider = 1; root.wizard-auto-upload = true; root.error = ""; }
                        }
                        ChoiceCard {
                            x: 0px;
                            y: root.compact ? 74px : 84px;
                            width: (parent.width - 8px) / 2;
                            height: root.compact ? 66px : 76px;
                            title: "Custom server";
                            subtitle: "Your own upload endpoint.";
                            selected: root.wizard-provider == 0;
                            clicked => { root.wizard-provider = 0; root.wizard-auto-upload = true; root.error = ""; }
                        }
                        ChoiceCard {
                            x: (parent.width + 8px) / 2;
                            y: root.compact ? 74px : 84px;
                            width: (parent.width - 8px) / 2;
                            height: root.compact ? 66px : 76px;
                            title: "Keep on this PC";
                            subtitle: "Do not upload automatically.";
                            selected: root.wizard-provider == -1;
                            clicked => { root.wizard-provider = -1; root.wizard-auto-upload = false; root.error = ""; }
                        }
                        ChoiceCard {
                            x: 0px;
                            y: root.compact ? 148px : 168px;
                            width: (parent.width - 8px) / 2;
                            height: root.compact ? 66px : 76px;
                            title: "vgy.me";
                            subtitle: "Images. Optional user key.";
                            selected: root.wizard-provider == 2;
                            clicked => { root.wizard-provider = 2; root.wizard-auto-upload = true; root.error = ""; }
                        }
                        ChoiceCard {
                            x: (parent.width + 8px) / 2;
                            y: root.compact ? 148px : 168px;
                            width: (parent.width - 8px) / 2;
                            height: root.compact ? 66px : 76px;
                            title: "transfer.sh";
                            subtitle: "Files. No account required.";
                            selected: root.wizard-provider == 4;
                            clicked => { root.wizard-provider = 4; root.wizard-auto-upload = true; root.error = ""; }
                        }
                        ChoiceCard {
                            x: 0px;
                            y: root.compact ? 222px : 252px;
                            width: (parent.width - 8px) / 2;
                            height: root.compact ? 66px : 76px;
                            title: "s-ul";
                            subtitle: "Requires an API key.";
                            selected: root.wizard-provider == 5;
                            clicked => { root.wizard-provider = 5; root.wizard-auto-upload = true; root.error = ""; }
                        }
                    }

                    if root.wizard-provider == 1: CompactField {
                        text <=> root.wizard-imgur-credential;
                        placeholder-text: "Imgur client ID";
                        input-type: InputType.password;
                        label: "Imgur client ID";
                    }
                    if root.wizard-provider == 2: CompactField {
                        text <=> root.wizard-vgy-credential;
                        placeholder-text: "Optional vgy.me user key";
                        input-type: InputType.password;
                        label: "vgy.me user key";
                    }
                    if root.wizard-provider == 5: CompactField {
                        text <=> root.wizard-sul-credential;
                        placeholder-text: "s-ul API key";
                        input-type: InputType.password;
                        label: "s-ul API key";
                    }
                    if root.wizard-provider == 0: CompactField {
                        text <=> root.wizard-uploader-url;
                        placeholder-text: "https://uploads.example/upload";
                        label: "Custom upload endpoint";
                        edited => { root.endpoint-edited(); root.error = ""; }
                    }
                    if root.wizard-provider == 0: VerticalLayout {
                        spacing: 8px;

                        Text {
                            text: "Advanced (optional): one authentication header and link lifetime.";
                            color: Theme.text-muted;
                            font-size: 12px;
                        }
                        HorizontalLayout {
                            spacing: 8px;

                            CompactField {
                                horizontal-stretch: 1;
                                text <=> root.wizard-header-name;
                                placeholder-text: "Header name";
                                label: "Request header name";
                                edited => { root.header-edited(); root.error = ""; }
                            }
                            CompactField {
                                horizontal-stretch: 1;
                                text <=> root.wizard-header-value;
                                placeholder-text: "Header value";
                                input-type: InputType.password;
                                label: "Request header value";
                                edited => { root.header-edited(); root.error = ""; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            SelectableButton { text: "1 hour"; selected: root.wizard-lifetime-seconds == 3600; clicked => { root.wizard-lifetime-seconds = 3600; } }
                            SelectableButton { text: "1 day"; selected: root.wizard-lifetime-seconds == 86400; clicked => { root.wizard-lifetime-seconds = 86400; } }
                            SelectableButton { text: "1 week"; selected: root.wizard-lifetime-seconds == 604800; clicked => { root.wizard-lifetime-seconds = 604800; } }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text { text: "lifetime"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                        }
                        Text {
                            text: "Current expiry: " + root.wizard-lifetime-seconds + " seconds";
                            color: Theme.text-muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                    if root.wizard-provider == 3 && !root.compact: Text {
                        text: "Uguu needs no account. Links are public and Uguu deletes files on its own schedule.";
                        color: Theme.text-muted;
                        font-size: 12.5px;
                        wrap: word-wrap;
                    }
                    if root.wizard-provider == 0 && !root.compact: Text {
                        text: "The endpoint receives a multipart upload and returns a public link.";
                        color: Theme.text-muted;
                        font-size: 12.5px;
                        wrap: word-wrap;
                    }
                    if root.wizard-provider == -1 && !root.compact: Text {
                        text: "Captures will be saved in your capture folder without uploading. The saved provider and credentials are kept.";
                        color: Theme.text-muted;
                        font-size: 12.5px;
                        wrap: word-wrap;
                    }

                    Text {
                        text: "Public links can be opened by anyone who has them. Do not upload private screenshots to a public host.";
                        color: Theme.accent;
                        font-size: 12.5px;
                        wrap: word-wrap;
                    }

                }
            }

            if root.step == 1: ScrollView {
                vertical-stretch: 1;
                min-height: 0px;

                VerticalLayout {
                    padding-right: 6px;
                    spacing: root.compact ? 8px : 14px;

                    Text { text: "Review your choices"; color: Theme.text; font-size: root.compact ? 18px : 21px; font-weight: 600; }
                    Text { text: root.resetting ? "Finish to reset other preferences and apply these choices. Cancel keeps all saved settings." : "Finish to save these choices. You can change them later in Settings."; color: Theme.text-soft; font-size: 13px; wrap: word-wrap; }

                    if root.compact: Text {
                        text: root.destination-name + " · Automatic upload " + (root.local-only ? "off" : (root.wizard-auto-upload ? "on" : "off")) + " · Local copies: " + root.local-copies;
                        color: Theme.text-muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    ToggleRow {
                        title: "Upload new captures automatically";
                        description: root.local-only ? "Off because uploads stay on this PC." : "Captures leave this PC and get a public link as soon as they are taken.";
                        enabled: !root.local-only;
                        checked <=> root.wizard-auto-upload;
                    }

                    if !root.compact: Rectangle {
                        border-radius: 9px;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: Theme.surface-raised;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;

                            HorizontalLayout {
                                Text { width: 130px; text: "Destination"; color: Theme.text-muted; font-size: 12.5px; }
                                Text { horizontal-stretch: 1; text: root.destination-name; color: Theme.text; font-size: 13px; font-weight: 600; }
                            }
                            HorizontalLayout {
                                Text { width: 130px; text: "Automatic upload"; color: Theme.text-muted; font-size: 12.5px; }
                                Text { horizontal-stretch: 1; text: root.local-only ? "Off" : (root.wizard-auto-upload ? "On" : "Off"); color: Theme.text; font-size: 13px; font-weight: 600; }
                            }
                            HorizontalLayout {
                                Text { width: 130px; text: "Local copies"; color: Theme.text-muted; font-size: 12.5px; }
                                Text { horizontal-stretch: 1; min-width: 0px; text: root.local-copies; color: Theme.text; font-size: 13px; font-weight: 600; wrap: word-wrap; }
                            }
                        }
                    }

                    ToggleRow {
                        title: "Play a sound after a successful upload";
                        description: "No sound for local saves or failed uploads. Independent of copying the link.";
                        checked <=> root.wizard-sound;
                    }
                    ToggleRow {
                        title: "Start ShareR when I sign in";
                        description: "Runs hidden in the notification area. Shortcuts work immediately.";
                        checked <=> root.wizard-start-at-login;
                    }

                    Text {
                        text: "You can change all of this in Settings. History stays on this computer.";
                        color: Theme.text-muted;
                        font-size: 12.5px;
                        wrap: word-wrap;
                    }

                }
            }

            if root.error != "": Text {
                text: root.error;
                color: Theme.danger;
                font-size: 12.5px;
                wrap: word-wrap;
            }

            Rectangle { height: 1px; background: Theme.border; }

            HorizontalLayout {
                spacing: 10px;

                FlatButton {
                    text: root.replay ? "Cancel" : "Use local only";
                    clicked => { root.skip(); }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                if root.step == 1: FlatButton {
                    text: "Back";
                    clicked => { root.step = 0; root.error = ""; }
                }
                if root.step == 0: FlatButton {
                    text: "Continue";
                    primary: true;
                    min-width: 104px;
                    clicked => { root.continue-setup(); }
                }
                if root.step == 1: FlatButton {
                    text: root.resetting ? "Reset and finish" : root.replay ? "Save setup" : "Start using ShareR";
                    primary: true;
                    min-width: 152px;
                    clicked => { root.finish(); }
                }
            }
        }
    }
}
