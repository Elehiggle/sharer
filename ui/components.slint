import { LineEdit } from "std-widgets.slint";
import { Icons, Theme } from "theme.slint";

export component Icon inherits Image {
    in property <color> tint: Theme.text-soft;
    in property <length> icon-size: 18px;

    width: root.icon-size;
    height: root.icon-size;
    image-fit: contain;
    colorize: root.tint;
    accessible-role: none;
}

export component IconBox inherits Rectangle {
    in property <image> icon-source;
    in property <color> tint: Theme.text-soft;
    in property <length> icon-size: 16px;
    in property <length> box-width: 18px;

    width: root.box-width;
    background: transparent;
    Icon {
        source: root.icon-source;
        tint: root.tint;
        icon-size: root.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

export component PageHeading inherits Text {
    color: Theme.text;
    font-size: Theme.font-title;
    font-weight: 600;
    vertical-alignment: center;
}

export component PageSubtitle inherits Text {
    color: Theme.text-soft;
    font-size: 13px;
    vertical-alignment: center;
}

export component SectionHeading inherits Text {
    color: Theme.text-soft;
    font-size: 13px;
    font-weight: 600;
    vertical-alignment: bottom;
}

export component CaptionText inherits Text {
    color: Theme.text-muted;
    font-size: Theme.font-caption;
    overflow: elide;
}

export component SectionCard inherits Rectangle {
    border-radius: Theme.card-radius;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    vertical-stretch: 0;
}

export component SettingsCard inherits Rectangle {
    border-radius: Theme.card-radius;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    vertical-stretch: 0;

    VerticalLayout {
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 0px;
        @children
    }
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <int> tone: 0;
    callback clicked;

    property <color> badge-color: root.tone == 4 ? Theme.danger : (root.tone == 3 ? Theme.accent : (root.tone == 2 ? Theme.success : (root.tone == 1 ? Theme.primary-bright : Theme.text-soft)));
    property <color> badge-background: root.tone == 4 ? Theme.danger-soft : (root.tone == 3 ? Theme.accent-soft : (root.tone == 2 ? Theme.success-soft : (root.tone == 1 ? Theme.primary-soft : Theme.surface-raised)));

    height: 22px;
    border-radius: 11px;
    background: root.badge-background;
    border-width: 1px;
    border-color: root.badge-color;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    forward-focus: badge-focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;

        Text {
            text: root.text;
            color: root.badge-color;
            font-size: 11.5px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    badge-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            badge-focus.focus();
            root.clicked();
        }
    }

    badge-focus := FocusScope {
        width: 0px;
        height: 0px;

        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

export component HelpBadge inherits Rectangle {
    in property <string> description;
    in property <string> title: "Help";
    in property <length> popup-width: 296px;
    in property <length> popup-height: 132px;

    width: 20px;
    height: 20px;
    border-radius: 10px;
    border-width: 1px;
    border-color: help-focus.has-focus || help-touch.has-hover ? Theme.primary-bright : Theme.border-bright;
    background: help-touch.has-hover ? Theme.surface-hover : Theme.surface-raised;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    forward-focus: help-focus;
    accessible-role: button;
    accessible-label: "Help: " + root.title;
    accessible-description: root.description;
    accessible-action-default => { help-popup.show(); }

    Text {
        text: "?";
        color: help-focus.has-focus ? Theme.primary-bright : Theme.text-soft;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.description != "": Tooltip { text: @markdown("\{root.description}"); }

    help-focus := FocusScope {
        width: 0px;
        height: 0px;

        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                help-popup.show();
                return accept;
            }
            return reject;
        }
    }

    help-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            help-focus.focus();
            help-popup.show();
        }
    }

    help-popup := PopupWindow {
        x: 0px;
        y: root.height + 6px;
        width: root.popup-width;
        min-height: root.popup-height;

        Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border-bright;
            background: Theme.surface-raised;

            VerticalLayout {
                padding: 12px;
                spacing: 6px;

                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                Text {
                    text: root.description;
                    color: Theme.text-soft;
                    font-size: 12.5px;
                    wrap: word-wrap;
                }
            }
        }
    }
}

export component FlatButton inherits Rectangle {
    in property <string> text;
    in property <image> icon-source;
    in property <bool> has-icon: false;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <string> description: "";
    callback clicked;
    property <bool> hovered: button-touch.has-hover;

    height: Theme.control-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.control-radius;
    border-width: 1px;
    border-color: !root.enabled ? Theme.border : (button-focus.has-focus ? Theme.primary-bright : (root.danger ? Theme.danger : (root.primary ? Theme.primary : Theme.border)));
    background: !root.enabled ? transparent : (root.primary ? (root.hovered ? Theme.primary-bright : Theme.primary) : (root.danger ? (root.hovered ? Theme.danger-soft : transparent) : (root.hovered ? Theme.surface-hover : Theme.surface-raised)));
    forward-focus: button-focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.description;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        spacing: 6px;

        if root.has-icon: IconBox {
            icon-source: root.icon-source;
            tint: !root.enabled ? Theme.text-muted : (root.primary ? Theme.bg : (root.danger ? Theme.danger : Theme.text-soft));
            icon-size: 13px;
            box-width: 14px;
        }
        Text {
            horizontal-stretch: 0;
            text: root.text;
            color: !root.enabled ? Theme.text-muted : (root.primary ? Theme.bg : (root.danger ? Theme.danger : Theme.text));
            font-size: 13px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    button-focus := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.enabled;

        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    if root.description != "": Tooltip { text: @markdown("\{root.description}"); }

    button-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            button-focus.focus();
            root.clicked();
        }
    }
}

export component SelectableButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <bool> outlined: true;
    in property <bool> enabled: true;
    callback clicked;
    property <bool> hovered: select-touch.has-hover;

    height: 30px;
    min-width: 64px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.control-radius;
    border-width: root.outlined || select-focus.has-focus ? 1px : 0px;
    border-color: select-focus.has-focus ? Theme.primary-bright : (root.selected ? Theme.primary : Theme.border);
    background: root.selected ? (root.outlined ? Theme.primary-soft : Theme.surface-raised) : (root.hovered ? Theme.surface-hover : (root.outlined ? Theme.surface-raised : transparent));
    opacity: root.enabled ? 1 : 0.5;
    forward-focus: select-focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    Text {
        text: root.text;
        color: root.selected ? Theme.primary-bright : Theme.text-soft;
        font-size: 12.5px;
        font-weight: root.selected ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        x: 9px;
        width: parent.width - 18px;
    }

    select-focus := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.enabled;

        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    select-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            select-focus.focus();
            root.clicked();
        }
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon-source;
    in property <string> description;
    in property <string> context: "";
    in property <bool> destructive: false;
    callback clicked;
    property <bool> hovered: icon-touch.has-hover;

    width: 32px;
    height: 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 6px;
    background: root.hovered ? (root.destructive ? Theme.danger-soft : Theme.surface-raised) : transparent;
    border-width: icon-focus.has-focus ? 1px : 0px;
    border-color: Theme.primary-bright;
    forward-focus: icon-focus;
    accessible-role: button;
    accessible-label: root.context == "" ? root.description : root.description + " for " + root.context;
    accessible-description: root.description;
    accessible-action-default => { root.clicked(); }

    Icon {
        source: root.icon-source;
        tint: root.destructive ? Theme.danger : (root.hovered ? Theme.primary-bright : Theme.text-soft);
        icon-size: 15px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    if root.description != "": Tooltip { text: @markdown("\{root.description}"); }

    icon-focus := FocusScope {
        width: 0px;
        height: 0px;

        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    icon-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            icon-focus.focus();
            root.clicked();
        }
    }
}

export component NavButton inherits Rectangle {
    in property <string> text;
    in property <image> icon-source;
    in property <bool> selected: false;
    in property <bool> compact: false;
    callback clicked;
    property <bool> hovered: nav-touch.has-hover;

    height: 40px;
    vertical-stretch: 0;
    border-radius: 7px;
    background: root.selected ? Theme.primary-soft : (root.hovered ? Theme.surface-hover : transparent);
    border-width: nav-focus.has-focus ? 1px : 0px;
    border-color: Theme.primary-bright;
    forward-focus: nav-focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: root.compact ? 0px : 11px;
        padding-right: root.compact ? 0px : 11px;
        spacing: 9px;
        alignment: root.compact ? center : start;

        IconBox {
            icon-source: root.icon-source;
            tint: root.selected ? Theme.primary-bright : Theme.text-soft;
            icon-size: 16px;
            box-width: 18px;
        }
        if !root.compact: Text {
            text: root.text;
            color: root.selected ? Theme.text : Theme.text-soft;
            font-size: 13.5px;
            font-weight: root.selected ? 600 : 450;
            vertical-alignment: center;
        }
    }

    nav-focus := FocusScope {
        width: 0px;
        height: 0px;

        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    if root.compact: Tooltip { text: @markdown("\{root.text}"); }

    nav-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            nav-focus.focus();
            root.clicked();
        }
    }
}

export component FieldLabel inherits Text {
    horizontal-alignment: left;
    color: Theme.text-soft;
    font-size: Theme.font-label;
    font-weight: 600;
    vertical-alignment: center;
}

export component Switch inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;

    width: 38px;
    height: 22px;
    border-radius: 11px;
    border-width: 1px;
    border-color: root.checked ? Theme.primary : Theme.border-bright;
    background: root.checked ? Theme.primary : Theme.surface-raised;
    opacity: root.enabled ? 1 : 0.5;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        y: 2px;
        x: root.checked ? parent.width - self.width - 2px : 2px;
        background: root.checked ? Theme.bg : Theme.text-soft;
        animate x { duration: 120ms; }
    }
}

export component LabelBlock inherits VerticalLayout {
    cross-axis-alignment: stretch;
    horizontal-stretch: 1;
    in property <string> label;
    in property <string> description: "";
    in property <string> help: "";

    spacing: 3px;

    HorizontalLayout {
        spacing: 6px;
        cross-axis-alignment: center;
        width: 100%;
        FieldLabel { text: root.label; min-width: 0px; wrap: word-wrap; }
        HelpBadge {
            visible: root.help != "";
            description: root.help;
            title: root.label;
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
    }
    if root.description != "": Text {
        horizontal-alignment: left;
        text: root.description;
        color: Theme.text-muted;
        font-size: 12.5px;
        wrap: word-wrap;
    }
}

export component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> description: "";
    in property <string> help: "";

    min-height: 56px;
    vertical-stretch: 0;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 20px;
        cross-axis-alignment: center;

        LabelBlock {
            width: 42%;
            horizontal-stretch: 0;
            label: root.label;
            description: root.description;
            help: root.help;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            cross-axis-alignment: stretch;
            spacing: 6px;
            @children
        }
    }
}

export component SettingGroup inherits Rectangle {
    in property <string> label;
    in property <string> description: "";
    in property <string> help: "";

    vertical-stretch: 0;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 10px;

        LabelBlock {
            label: root.label;
            description: root.description;
            help: root.help;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 8px;
            @children
        }
    }
}

export component ToggleRow inherits Rectangle {
    in-out property <bool> checked;
    in property <string> title;
    in property <string> description: "";
    in property <string> help: "";
    in property <bool> enabled: true;
    callback toggled;
    property <bool> hovered: toggle-touch.has-hover;

    min-height: 58px;
    vertical-stretch: 0;
    border-radius: 6px;
    background: root.hovered && root.enabled ? Theme.surface-hover : transparent;
    border-width: toggle-focus.has-focus ? 1px : 0px;
    border-color: Theme.primary-bright;
    forward-focus: toggle-focus;
    accessible-role: switch;
    accessible-label: root.title;
    accessible-description: root.description;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.checked = !root.checked; root.toggled(); } }

    toggle-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            toggle-focus.focus();
            root.checked = !root.checked;
            root.toggled();
        }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 20px;

        VerticalLayout {
            horizontal-stretch: 1;
            cross-axis-alignment: stretch;
            spacing: 3px;

            HorizontalLayout {
                spacing: 6px;
                cross-axis-alignment: center;
                width: 100%;
                Text {
                    horizontal-alignment: left;
                    text: root.title;
                    color: root.enabled ? Theme.text : Theme.text-muted;
                    font-size: 13.5px;
                    font-weight: 600;
                    min-width: 0px;
                    wrap: word-wrap;
                }
                HelpBadge {
                    visible: root.help != "";
                    description: root.help;
                    title: root.title;
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
            }
            if root.description != "": Text {
                horizontal-alignment: left;
                text: root.description;
                color: Theme.text-muted;
                font-size: 12.5px;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            width: 38px;
            alignment: center;

            Switch {
                checked: root.checked;
                enabled: root.enabled;
            }
        }
    }

    toggle-focus := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.enabled;

        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.checked = !root.checked;
                root.toggled();
                return accept;
            }
            return reject;
        }
    }
}

export component CompactField inherits LineEdit {
    in property <bool> field-enabled: true;
    in property <string> label: "";
    in property <string> hint: "";

    height: 34px;
    vertical-stretch: 0;
    opacity: root.field-enabled ? 1 : 0.55;
    enabled: root.field-enabled;
    accessible-label: root.label;
    accessible-description: root.hint;
}

export component CompactSelect inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    in property <bool> control-enabled: true;
    in property <string> label: "";
    in property <string> hint: "";
    property <bool> hovered: select-touch.has-hover;

    height: 32px;
    min-width: 150px;
    vertical-stretch: 0;
    border-radius: Theme.control-radius;
    border-width: 1px;
    border-color: select-focus.has-focus || choices.is-open ? Theme.primary : Theme.border;
    background: root.hovered ? Theme.surface-hover : Theme.surface-raised;
    opacity: root.control-enabled ? 1 : 0.5;
    forward-focus: select-focus;
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-description: root.hint;
    accessible-enabled: root.control-enabled;
    accessible-expandable: true;
    accessible-expanded: choices.is-open;
    accessible-value: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";
    accessible-action-expand => { if (root.control-enabled) { choices.show(); } }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 9px;
        spacing: 6px;

        Text {
            horizontal-stretch: 1;
            text: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";
            color: Theme.text;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
        IconBox {
            icon-source: Icons.chevron-down;
            tint: Theme.text-soft;
            icon-size: 10px;
            box-width: 12px;
        }
    }

    select-focus := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.control-enabled;

        key-pressed(event) => {
            if event.text == Key.DownArrow {
                root.current-index = min(root.model.length - 1, root.current-index + 1);
                return accept;
            }
            if event.text == Key.UpArrow {
                root.current-index = max(0, root.current-index - 1);
                return accept;
            }
            if event.text == Key.Home {
                root.current-index = 0;
                return accept;
            }
            if event.text == Key.End {
                root.current-index = max(0, root.model.length - 1);
                return accept;
            }
            if event.text == Key.Space || event.text == Key.Return {
                choices.show();
                return accept;
            }
            return reject;
        }
    }

    select-touch := TouchArea {
        enabled: root.control-enabled;
        mouse-cursor: root.control-enabled ? pointer : default;
        clicked => {
            select-focus.focus();
            choices.show();
        }
    }

    choices := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        height: root.model.length * 32px + 8px;

        Rectangle {
            background: Theme.surface-raised;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border-bright;

            VerticalLayout {
                padding: 4px;

                for option[index] in root.model: Rectangle {
                    height: 32px;
                    border-radius: 5px;
                    background: index == root.current-index ? Theme.primary-soft : (option-touch.has-hover ? Theme.surface-hover : transparent);

                    Text {
                        text: option;
                        color: index == root.current-index ? Theme.primary-bright : Theme.text;
                        font-size: 13px;
                        font-weight: index == root.current-index ? 600 : 450;
                        vertical-alignment: center;
                        x: 10px;
                        width: parent.width - 20px;
                        overflow: elide;
                    }
                    option-touch := TouchArea {
                        enabled: root.control-enabled;
                        mouse-cursor: pointer;
                        clicked => {
                            root.current-index = index;
                            choices.close();
                            select-focus.focus();
                        }
                    }
                }
            }
        }
    }
}

export component NumberStepper inherits Rectangle {
    in-out property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step-size: 1;
    in property <string> label: "";
    in property <string> hint: "";
    in property <bool> enabled: true;

    height: 32px;
    min-width: 112px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.control-radius;
    border-width: 1px;
    border-color: stepper-focus.has-focus ? Theme.primary : Theme.border;
    background: Theme.surface-raised;
    opacity: root.enabled ? 1 : 0.5;
    forward-focus: stepper-focus;
    accessible-role: spinbox;
    accessible-label: root.label;
    accessible-description: root.hint;
    accessible-enabled: root.enabled;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step-size;
    accessible-action-increment => { if root.enabled { root.value = min(root.maximum, root.value + root.step-size); } }
    accessible-action-decrement => { if root.enabled { root.value = max(root.minimum, root.value - root.step-size); } }

    HorizontalLayout {
        minus := Rectangle {
            width: 28px;
            background: minus-touch.has-hover && root.value > root.minimum ? Theme.surface-hover : transparent;

            Text {
                text: "−";
                color: root.value > root.minimum ? Theme.text-soft : Theme.text-muted;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            minus-touch := TouchArea {
                enabled: root.enabled && root.value > root.minimum;
                mouse-cursor: self.enabled ? pointer : default;
                clicked => {
                    stepper-focus.focus();
                    root.value = max(root.minimum, root.value - root.step-size);
                }
            }
        }
        Rectangle { width: 1px; background: Theme.border; }
        Text {
            min-width: 54px;
            horizontal-stretch: 1;
            text: "\{root.value}";
            color: Theme.text;
            font-size: 13px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Rectangle { width: 1px; background: Theme.border; }
        plus := Rectangle {
            width: 28px;
            background: plus-touch.has-hover && root.value < root.maximum ? Theme.surface-hover : transparent;

            Text {
                text: "+";
                color: root.value < root.maximum ? Theme.text-soft : Theme.text-muted;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            plus-touch := TouchArea {
                enabled: root.enabled && root.value < root.maximum;
                mouse-cursor: self.enabled ? pointer : default;
                clicked => {
                    stepper-focus.focus();
                    root.value = min(root.maximum, root.value + root.step-size);
                }
            }
        }
    }

    stepper-focus := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.enabled;

        key-pressed(event) => {
            if event.text == Key.UpArrow {
                root.value = min(root.maximum, root.value + root.step-size);
                return accept;
            }
            if event.text == Key.DownArrow {
                root.value = max(root.minimum, root.value - root.step-size);
                return accept;
            }
            if event.text == Key.PageUp {
                root.value = min(root.maximum, root.value + root.step-size * 10);
                return accept;
            }
            if event.text == Key.PageDown {
                root.value = max(root.minimum, root.value - root.step-size * 10);
                return accept;
            }
            if event.text == Key.Home {
                root.value = root.minimum;
                return accept;
            }
            if event.text == Key.End {
                root.value = root.maximum;
                return accept;
            }
            return reject;
        }
    }
}

export component InlineNotice inherits Rectangle {
    in property <string> text;
    in property <string> detail: "";
    in property <string> action-text: "";
    in property <int> kind: 0;
    callback action();

    property <color> notice-color: root.kind == 2 ? Theme.danger : (root.kind == 1 ? Theme.primary-bright : Theme.accent);
    property <color> notice-background: root.kind == 2 ? Theme.danger-soft : (root.kind == 1 ? Theme.primary-soft : Theme.accent-soft);
    min-height: 44px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.notice-color;
    background: root.notice-background;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 10px;

        IconBox {
            icon-source: root.kind == 1 ? Icons.update : Icons.warning;
            tint: root.notice-color;
            icon-size: 15px;
            box-width: 17px;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;

            Text {
                text: root.text;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                wrap: word-wrap;
            }
            if root.detail != "": Text {
                text: root.detail;
                color: Theme.text-soft;
                font-size: 12.5px;
                wrap: word-wrap;
            }
        }
        if root.action-text != "": FlatButton {
            text: root.action-text;
            clicked => { root.action(); }
        }
    }
}

export component ChoiceCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";
    in property <bool> selected: false;
    callback clicked;
    property <bool> hovered: choice-touch.has-hover;

    height: 76px;
    border-radius: 9px;
    border-width: 1px;
    border-color: root.selected ? Theme.primary : (root.hovered ? Theme.border-bright : Theme.border);
    background: root.selected ? Theme.primary-soft : (root.hovered ? Theme.surface-hover : Theme.surface);
    forward-focus: choice-focus;
    accessible-role: checkbox;
    accessible-label: root.title;
    accessible-description: root.subtitle;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 11px;

        VerticalLayout {
            width: 18px;
            alignment: center;

            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                border-width: 1px;
                border-color: root.selected ? Theme.primary-bright : Theme.border-bright;
                background: root.selected ? Theme.primary : Theme.surface-raised;

                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.bg;
                    visible: root.selected;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                color: Theme.text;
                font-size: 13.5px;
                font-weight: 600;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Theme.text-muted;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }

    choice-focus := FocusScope {
        width: 0px;
        height: 0px;

        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    choice-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            choice-focus.focus();
            root.clicked();
        }
    }
}

export component StatusBar inherits Rectangle {
    in property <string> text: "Ready";
    in property <string> detail: "";
    in property <bool> busy: false;
    in property <bool> error: false;

    height: Theme.status-height;
    background: Theme.sidebar;
    accessible-role: banner;
    accessible-live-region: polite;
    accessible-label: root.text + (root.detail != "" ? ": " + root.detail : "");

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        y: 1px;
        height: parent.height - 1px;
        padding-left: 20px;
        padding-right: 20px;
        spacing: 9px;

        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.error ? Theme.danger : (root.busy ? Theme.accent : Theme.success);
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            color: root.error ? Theme.danger : Theme.text;
            font-size: 12.5px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.detail;
            color: Theme.text-muted;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    if root.detail != "": Tooltip { text: @markdown("\{root.detail}"); }
}
