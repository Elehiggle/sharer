import { Theme } from "theme.slint";
import { FlatButton, PageHeading } from "components.slint";

export component FfmpegSetup inherits Rectangle {
    in property <bool> downloading;
    in property <float> progress;
    in property <string> message;
    callback download();
    callback cancel();
    property <bool> cancel-focused: false;
    background: #00000099;
    TouchArea { }
    init => { download-button.focus(); }
    changed downloading => {
        if root.downloading { root.cancel-focused = true; cancel-button.focus(); }
    }
    keyboard-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); return accept; }
            if event.text == Key.Tab {
                root.cancel-focused = root.downloading || !root.cancel-focused;
                if root.cancel-focused { cancel-button.focus(); }
                else { download-button.focus(); }
                return accept;
            }
            return reject;
        }
        Rectangle {
            width: min(480px, parent.width - 40px);
            height: content.preferred-height + 40px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.surface;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 10px;
            content := VerticalLayout {
                padding: 20px;
                spacing: 16px;
                PageHeading { text: root.downloading ? "Setting up FFmpeg" : "FFmpeg required"; }
                Text { text: root.message; wrap: word-wrap; color: Theme.text-soft; }
                if root.downloading: Rectangle {
                    height: 5px;
                    background: Theme.surface-raised;
                    border-radius: 2px;
                    Rectangle { x: 0px; y: 0px; width: parent.width * root.progress; height: parent.height; background: Theme.primary; border-radius: 2px; }
                }
                HorizontalLayout {
                    spacing: root.downloading ? 0px : 8px;
                    Rectangle { horizontal-stretch: 1; }
                    cancel-button := FlatButton { width: 90px; text: "Cancel"; clicked => { root.cancel(); } }
                    download-button := FlatButton { visible: !root.downloading; enabled: !root.downloading; width: root.downloading ? 0px : 110px; text: "Download"; primary: true; clicked => { root.download(); } }
                }
            }
        }
    }
}
